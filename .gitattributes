# Jak má GitHub počítat jazyky a zobrazovat diffy.

# ikony.ts a logo.ts nejsou psané řádky kódu, ale vygenerované SVG dráhy
# (dělá je scripts/kresli-ikony.mjs a scripts/prevod-loga.py). Nafukovalo to
# podíl jazyka a v diffu se to pokaždé rozbalilo na desítky kB čísel.
src/lib/ikony.ts linguist-generated=true
src/lib/logo.ts linguist-generated=true

# Apple HIG skilly jsou převzaté odjinud (raintree-technology/apple-hig-skills),
# nepíšeme je my.
.claude/skills/** linguist-vendored=true

# Písma a obrázky jsou binární, ať se je git nesnaží slučovat.
*.woff2 binary
*.png binary
